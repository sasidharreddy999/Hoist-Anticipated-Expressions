+using ExpressionSet = DenseSet<size_t>;
+
+class HoistAnticipatedExpressions
+    : public PassInfoMixin<HoistAnticipatedExpressions> {
+public:
+  PreservedAnalyses run(Function &F, FunctionAnalysisManager &AM);
+
+  void computeAnticipatedExpressions(
+      Function &F, DenseMap<BasicBlock *, ExpressionSet> &GENMap,
+      DenseMap<BasicBlock *, ExpressionSet> &KILLMap,
+      DenseMap<BasicBlock *, ExpressionSet> &INMap,
+      DenseMap<BasicBlock *, ExpressionSet> &OUTMap,
+      DenseMap<size_t, SmallVector<Instruction *, 4>> &ExprMap);
+
+  void
+  hoistExpressions(Function &F, DenseMap<BasicBlock *, ExpressionSet> &OUTMap,
+                   DenseMap<size_t, SmallVector<Instruction *, 4>> &ExprMap);
+};
+
